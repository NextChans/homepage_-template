# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.co.kr

# ─────────────────────────────────────────────────────────────
# Supabase (문의 접수 저장용)
#  - URL / ANON_KEY: 클라이언트 노출 가능
#  - SERVICE_ROLE_KEY: 서버 전용. 절대 NEXT_PUBLIC_ 접두어 금지.
#    Server Action 에서만 사용하며 RLS 를 우회한다.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 문의자 IP 를 원문 저장하지 않고 해시하기 위한 salt (32바이트 이상 랜덤값)
#  예: openssl rand -hex 32
INQUIRY_IP_HASH_SALT=
