# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.co.kr

# ─────────────────────────────────────────────────────────────
# Supabase
#
# 변수 이름은 두 가지 체계를 모두 지원한다 (lib/supabase/server.ts).
#
#   URL     : NEXT_PUBLIC_SUPABASE_URL  또는  SUPABASE_URL
#   비밀키  : SUPABASE_SECRET_KEY       또는  SUPABASE_SERVICE_ROLE_KEY
#             (신형 sb_secret_... 을 먼저 본다. 레거시 service_role JWT 는
#              2026년 말 지원 종료 예정이므로 신형 사용을 권장한다)
#
# Vercel 의 Supabase Marketplace 연동을 쓰면 SUPABASE_URL / SUPABASE_SECRET_KEY /
# NEXT_PUBLIC_SUPABASE_URL 이 자동 주입되므로 아래를 수동 입력할 필요가 없다.
#
# ⚠️ 비밀키에는 절대 NEXT_PUBLIC_ 접두어를 붙이지 않는다.
#    붙이면 클라이언트 번들에 포함되어 RLS 가 완전히 무력화된다.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 신형 publishable 키. 현재 코드에서는 사용하지 않는다(향후 클라이언트 조회용).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────
# 상담 접수 Slack 알림 (선택)
#
# 미설정이면 알림을 조용히 건너뛴다. 접수 자체에는 영향이 없다.
# 현재 문의 폼은 content/features.ts 에서 꺼져 있어 호출되지 않는다.
#
# 발급: Slack → Apps → Incoming Webhooks → Add to Slack → 채널 선택
#   https://api.slack.com/messaging/webhooks
#
# ⚠️ 알림에는 개인정보(이름·이메일·연락처·문의 본문)를 넣지 않는다.
#    분야·회사명·행 id 만 보내고 실제 내용은 Supabase 에서 본다.
#    자세한 이유는 lib/notify/slack.ts 주석 참고.
# ─────────────────────────────────────────────────────────────
SLACK_INQUIRY_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# 문의자 IP 해시용 salt
#
# Supabase 에서 받는 값이 아니다. 직접 생성한다:
#   openssl rand -hex 32
#
# 이 값이 없으면 IP 해시를 아예 저장하지 않는다(레이트리밋 정확도만 낮아진다).
# 값을 교체하면 기존 해시와 매칭이 끊겨 레이트리밋 이력이 초기화된다.
# ─────────────────────────────────────────────────────────────
INQUIRY_IP_HASH_SALT=

# ─────────────────────────────────────────────────────────────
# 관리자 페이지 (/admin) — 상담 문의 조회
#
# ⚠️ 셋 중 하나라도 비어 있으면 /admin 전체가 404 가 된다(의도된 동작).
#    설정하지 않으면 관리자 기능이 "존재하지 않는다".
#
# 값 생성:
#   node scripts/hash-admin-password.mjs '실제-비밀번호'
#   → ADMIN_PASSWORD_HASH 와 ADMIN_SESSION_SECRET 을 함께 출력한다
#
# Vercel 등록 시 타입은 셋 다 Secret 으로 한다(NEXT_PUBLIC_ 접두어 금지).
# ADMIN_SESSION_SECRET 을 교체하면 기존 로그인 세션이 모두 무효화된다.
#
# ⚠️ 이 화면은 문의자의 개인정보 전체를 표시한다. 자격증명을 공유하지 말고,
#    접근 권한자 명단을 관리할 것. 모든 조회는 admin_audit_log 에 기록된다.
# ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
